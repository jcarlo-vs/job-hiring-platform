# ----------------------------------------------------------------------------
# Neon Postgres
#
# Two connection strings, and the difference is the security model:
#   DATABASE_URL      owner role, rolbypassrls = true. Admin paths only.
#   APP_DATABASE_URL  app_user, RLS APPLIES. All user traffic.
# Connecting the app as the owner would silently disable every RLS policy.
#
# DATABASE_URL_UNPOOLED (direct, no PgBouncer) is only needed for migrations.
# ----------------------------------------------------------------------------
DATABASE_URL=
APP_DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ----------------------------------------------------------------------------
# AWS Cognito - authentication
# From `terraform output` in infra/.
# ----------------------------------------------------------------------------
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Hosted UI domain, from `terraform output cognito_hosted_domain`.
# This doubles as the feature flag for social sign-in: the "Continue with
# Google" button renders only when it is set, so leave it blank until the
# Google identity provider actually exists in the pool.
COGNITO_HOSTED_DOMAIN=


# ----------------------------------------------------------------------------
# Anthropic (Phase 4) - AI resume screening
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# AWS (Phase 7) - background jobs on SQS + Lambda.
#
# Local dev: set QUEUE_LOCAL=1 and the queue helpers invoke the worker handler
# in-process, so no AWS access and no second terminal are needed. Leave the rest
# blank locally.
#
# Production: the queue URLs and the publish-only IAM key come from
# `terraform output` in infra/. The key can ONLY SendMessage to these two
# queues. The workers themselves read their secrets from SSM Parameter Store,
# not from here.
# ----------------------------------------------------------------------------
# Note the SQS_ prefix rather than AWS_. Vercel Functions run on AWS Lambda,
# which reserves AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION for its
# own execution role and sets them at runtime, so anything stored under those
# names would be silently clobbered.
QUEUE_LOCAL=1
SCREENING_QUEUE_URL=
EMAIL_QUEUE_URL=
SQS_REGION=ap-southeast-1
SQS_ACCESS_KEY_ID=
SQS_SECRET_ACCESS_KEY=

# Private S3 bucket holding resumes. From `terraform output RESUME_BUCKET`.
RESUME_BUCKET=

# ----------------------------------------------------------------------------
# Resend (Phase 6) - transactional email
# Without RESEND_API_KEY the email steps no-op (logged), so the app still runs.
# RESEND_FROM must be a verified sender; the shared onboarding@resend.dev only
# delivers to your own Resend account email until you verify a domain.
# ----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="TalentScreen <onboarding@resend.dev>"

# Public base URL used for links in emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://job-hiring-platform-eight.vercel.app
